{
  "name": "hotlap",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter @hotlap/api dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @hotlap/api db:generate",
    "db:migrate": "pnpm --filter @hotlap/api db:migrate",
    "db:seed": "pnpm --filter @hotlap/api db:seed",
    "db:studio": "pnpm --filter @hotlap/api db:studio",
    "db:reset": "pnpm --filter @hotlap/api db:reset"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}